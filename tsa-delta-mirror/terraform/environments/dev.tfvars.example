# Copy to dev.tfvars (git-ignored) and fill in. Nothing here is secret: the sharing token goes
# into the Secrets Manager secret after `terraform apply` (see README).
region      = "us-gov-west-1"
environment = "dev"

vpc_id             = "vpc-0123456789abcdef0"
private_subnet_ids = ["subnet-0aaaaaaaaaaaaaaaa", "subnet-0bbbbbbbbbbbbbbbb"]
route_table_ids    = ["rtb-0ccccccccccccccc"]
create_vpc_endpoints = true

provider_endpoint_host = "sharing.provider.example.gov"
provider_storage_hosts = ["provider-share-bucket.s3.us-gov-west-1.amazonaws.com"]

lake_bucket_name   = "tsa-data-lake-dev"
create_lake_bucket = false
lake_prefix        = "bronze/shared"
lake_kms_key_arn   = "arn:aws-us-gov:kms:us-gov-west-1:111122223333:key/00000000-0000-0000-0000-000000000000"

image_tag   = "sha-0123abcd"
task_cpu    = 1024
task_memory = 4096

register_glue      = true
glue_database_name = "bronze_shared"

alarm_sns_topic_arn  = null
alarm_period_seconds = 3600

tables = [
  {
    share        = "provider_share"
    schema       = "provider_schema"
    table        = "incidents"
    mode         = "auto"
    primary_keys = ["incident_id"]
    schedule     = "rate(1 hour)"
  },
  {
    share    = "provider_share"
    schema   = "provider_schema"
    table    = "reference_codes"
    mode     = "snapshot"
    schedule = "cron(15 6 * * ? *)"
  },
]

tags = {
  Owner = "TSA Data Platform"
  ATO   = "tsa-data-lake"
}
